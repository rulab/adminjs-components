    "@editorjs/editorjs": "~2.30.2",
    "@editorjs/header": "~2.8.7",
    "@editorjs/image": "~2.9.2",
    "@editorjs/list": "~1.9.0",
    "@editorjs/paragraph": "~2.11.6",
    "@editorjs/quote": "~2.7.2",
    "@editorjs/table": "~2.4.1",
    "chroma-js": "^3.0.0",
    "editorjs-audio-player": "~0.0.3",
    "editorjs-html": "~3.4.3",
    "react-select": "^5.8.0",
    "slugify": "^1.6.6"
