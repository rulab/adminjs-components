{
  "name": "@rulab/adminjs-components",
  "version": "0.4.1",
  "description": "Prebuilt AdminJS features for common UI needs.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": false,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "adminjs",
    "components",
    "react",
    "editorjs"
  ],
  "homepage": "https://github.com/rulab/adminjs-components#readme",
  "bugs": {
